# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.cache/

# Nested upstream checkouts keep their own histories
/external/

# Recordings, trained weights, and run artifacts
/data/
/checkpoints/
/outputs/
*.h5
*.hdf5
*.pt
