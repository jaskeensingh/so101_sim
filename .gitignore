# Downloaded assets: track their descriptions/provenance instead
/assets/**
!/assets/**/
!/assets/**/README.md

# Large binary scene formats are opt-in; small .usda compositions can be tracked
*.usd
*.usdc
*.usdz

# Local credentials and machine-specific files
.env
.env.*
!.env.example
.DS_Store

